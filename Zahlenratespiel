

import random

zahl = random.randint(1, 100)

print("Willkommen zum Zahlenraten-Spiel!")


def spiel(zahl):

    weitermachen = True
    while weitermachen:
        tipp = int(input("Was ist dein Tipp? "))

        if tipp < zahl:
            print("Zu niedrig! Versuch es nochmal.")
        elif tipp > zahl:
            print("Zu hoch! Versuch es nochmal.")
        else:
            print("Herzlichen Glückwunsch! Du hast die Zahl erraten.")
            weitermachen = False

spiel(zahl)

weitermachen = True

while weitermachen:
    weiter = input("Wenn du das Spiel beenden möchtest, drücke Enter.\nWenn nicht, tippe 'weiter'. ")

    if weiter.lower() == "weiter":
        print("Okay, lass uns weiterspielen!")
        zahl = random.randint(1, 100)
        spiel(zahl)
    else:
        print("Danke fürs Spielen! Auf Wiedersehen!")
        weitermachen = False
